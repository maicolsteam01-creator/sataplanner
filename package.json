{
  "name": "sataplanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SataPlanner - planificador de blueprints para Satisfactory",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sataplanner/web",
    "build": "npm run build --workspace @sataplanner/web",
    "preview": "npm run preview --workspace @sataplanner/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/engine/tsconfig.json",
    "data:import": "node scripts/import-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
